{
  "name": "o1js-scan",
  "version": "0.13.0",
  "description": "Static soundness analyzer for o1js / Mina zkApps and Noir circuits",
  "license": "Apache-2.0",
  "homepage": "https://github.com/auditinfra-io/o1js-scan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auditinfra-io/o1js-scan.git"
  },
  "bugs": {
    "url": "https://github.com/auditinfra-io/o1js-scan/issues"
  },
  "keywords": [
    "o1js",
    "mina",
    "noir",
    "aztec",
    "zk",
    "zkapp",
    "circuit",
    "security",
    "static-analysis",
    "audit"
  ],
  "bin": {
    "o1js-scan": "./bin/o1js-scan.js",
    "noir-scan": "./bin/noir-scan.js"
  },
  "files": [
    "bin/",
    "o1js_scan/*.py",
    "o1js_scan/py.typed",
    "README.md",
    "LICENSE",
    "pyproject.toml"
  ],
  "engines": {
    "node": ">=16"
  },
  "peerDependencies": {
    "o1js": ">=1"
  },
  "peerDependenciesMeta": {
    "o1js": {
      "optional": true
    }
  },
  "scripts": {
    "test:npm-wrapper": "node tests/npm/wrapper-smoke.js",
    "format": "npx --yes prettier@3 --write \"bin/**/*.js\" \"tests/npm/**/*.js\" .prettierrc.cjs",
    "format:check": "npx --yes prettier@3 --check \"bin/**/*.js\" \"tests/npm/**/*.js\" .prettierrc.cjs"
  }
}
